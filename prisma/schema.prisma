// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: On the VPS, DATABASE_URL MUST be set to an absolute path
// outside the project directory so the database survives deploys.
// Example: DATABASE_URL=file:/home/consult-rms/data/rms.db
// This is set automatically by deploy.sh and ecosystem.config.cjs.

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RmsData {
  id        String   @id @default(cuid())
  key       String   @unique
  data      String   // JSON blob
  updatedAt DateTime @updatedAt
}